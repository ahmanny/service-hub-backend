<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI',
        Roboto, Helvetica, Arial, sans-serif;
    "
  >
    <div style="max-width: 480px; margin: 0 auto; padding: 24px;">
      <div
        style="
          background-color: #ffffff;
          border-radius: 16px;
          padding: 32px 24px;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
          text-align: center;
        "
      >
        <h1 style="margin: 0; font-size: 24px; font-weight: 700; color: #1e8a4b;">
          Proxxi
        </h1>

        <div style="height: 24px;"></div>

        <h2 style="margin: 0; font-size: 20px; font-weight: 600; color: #111;">
          Verify your email address
        </h2>

        <p
          style="
            margin: 16px 0 24px;
            font-size: 15px;
            line-height: 1.6;
            color: #555;
          "
        >
          Use the 6-digit verification code below in your mobile app to verify your email address.
        </p>

        <div
          style="
            font-size: 32px;
            letter-spacing: 8px;
            font-weight: 700;
            color: #1e8a4b;
            background-color: #f0faf5;
            padding: 16px 0;
            border-radius: 12px;
            margin-bottom: 24px;
          "
        >
          {{otpCode}}
        </div>

        <p
          style="
            margin: 0 0 16px;
            font-size: 14px;
            color: #666;
          "
        >
          Or click the button below to verify directly:
        </p>

        <div style="margin-bottom: 28px;">
          <a
            href="{{verificationUrl}}"
            style="
              background-color: #1e8a4b;
              color: #ffffff;
              text-decoration: none;
              padding: 14px 28px;
              border-radius: 10px;
              font-size: 15px;
              font-weight: 600;
              display: inline-block;
            "
          >
            Verify Email Now
          </a>
        </div>

        <p
          style="
            margin: 0;
            font-size: 13px;
            line-height: 1.5;
            color: #777;
          "
        >
          If you didn’t request this code, you can safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <p
        style="
          text-align: center;
          font-size: 12px;
          color: #999;
          margin-top: 16px;
        "
      >
        © {{year}} Proxxi. All rights reserved.
      </p>
    </div>
  </body>
</html>
