<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Issue Report - Proxxi</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f4f6f8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <div style="max-width: 600px; margin: 0 auto; padding: 24px;">
      <div style="background-color: #ffffff; border-radius: 16px; padding: 32px 24px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);">
        <div style="text-align: center; margin-bottom: 24px;">
          <img src="{{logoUrl}}" alt="Proxxi" style="height: 40px; margin-bottom: 16px;" />
          <h1 style="margin: 0; font-size: 24px; font-weight: 700; color: #dc2626; border-bottom: 2px solid #dc2626; padding-bottom: 12px; display: inline-block;">
            New Issue Report
          </h1>
        </div>

        <div style="margin-bottom: 20px;">
          <p style="margin: 0 0 8px; font-size: 14px; color: #555;">
            <strong>Category:</strong>
            <span style="background-color: #fef2f2; color: #dc2626; padding: 3px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-left: 8px;">{{category}}</span>
          </p>
          {{#if bookingId}}
          <p style="margin: 0 0 8px; font-size: 14px; color: #555;"><strong>Booking ID:</strong> {{bookingId}}</p>
          {{/if}}
          {{#if email}}
          <p style="margin: 0; font-size: 14px; color: #555;">
            <strong>Reporter Email:</strong> <a href="mailto:{{email}}" style="color: #dc2626; text-decoration: none;">{{email}}</a>
          </p>
          {{/if}}
        </div>

        <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;" />

        <div style="background-color: #f9f9f9; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
          <h3 style="margin: 0 0 12px; font-size: 16px; color: #333;">Issue Description:</h3>
          <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #555; white-space: pre-wrap;">{{description}}</p>
        </div>

        <p style="margin: 0; font-size: 12px; color: #999; text-align: center;">
          Sent from Proxxi Report Form &bull; {{timestamp}}
        </p>
      </div>

      <p style="text-align: center; font-size: 12px; color: #999; margin-top: 16px;">
        &copy; {{year}} Proxxi. All rights reserved.
      </p>
    </div>
  </body>
</html>